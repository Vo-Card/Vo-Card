<div style="width: 100%;
            height: 100%;">
    <userSetting>
        <form id="user-setting" method="post" autocomplete="off"
            style="padding-bottom: 10px; border-bottom: 1px solid white;">
            <div style="
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        align-items: center;
                        display: flex;">
                <p style="width: 25%; margin: 0px;">Displayname :</p>
                <input style="padding-left: 10px;" value="asdf" name="new-display-name" id="new-display-name"
                    type="text" placeholder="New Displayname">
            </div>

            <div style="
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        align-items: center;
                        display: flex;">
                <p style="width: 25%; margin: 0px;">Username :</p>
                <input style="padding-left: 10px;" value="Username" name="new-username" id="new-username" type="text"
                    placeholder="New Username">
            </div>

            <div style="
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        align-items: center;
                        display: flex;">
                <p style="width: 25%; margin: 0px;">Password :</p>
                <input style="padding-left: 10px;" value="" name="Confirm New Password"" id=" new-password" type="text"
                    placeholder="New Password">
            </div>

            <div style="
                        padding-right: 10px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        align-items: center;
                        display: flex;">
                <p style="width: 25%; margin: 0px;">Password :</p>
                <input style="padding-left: 10px;" value="" name="Confirm New Password"" id=" confirm-new-password"
                    type="text" placeholder="Confirm New Password">
            </div>
        </form>

        <div style="width: 100%; 
            padding-top: 10px; 
            padding-bottom: 10px; 
            display: flex; 
            justify-content: space-between;
            ">
            <delete-user style="background-color: #972626;
            ">Delete Account</delete-user>

            <div style="display: flex; 
                        gap: 6px;
                        ">
                <logout style="background-color: #C26262;
                ">Log-out</logout>

                <save style="background-color: #628AC2;
                ">Save</save>
            </div>

        </div>

    </userSetting>
</div>