{
  "compilerOptions": {
    "checkJs": true,
    "target": "es2020",
    "lib": [
      "es2020",
      "dom"
    ],
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "/js/*": [
        "src/main/webapp/js/*"
      ]
    }
  },
  "include": [
    "src/main/webapp/js/**/*"
  ]
}